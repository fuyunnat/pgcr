# PGCR Mirror v0.2 runtime configuration.
# This belongs to /mnt/app/root/pgcr and does NOT overwrite upstream MMI Mirror config.

PGCR_CAPTURE_FPS=30
PGCR_CAPTURE_RECOVER_MS=3000
PGCR_HMI_POLL_MS=100

PGCR_CLASSIC_FULL_MODE=cover
PGCR_CLASSIC_FULL_ZOOM=1.00
PGCR_CLASSIC_FULL_PAN_X=0.00
PGCR_CLASSIC_FULL_PAN_Y=0.00

PGCR_CLASSIC_FULL_SCALE=0.63
PGCR_CLASSIC_FULL_OFFSET_X=0
PGCR_CLASSIC_FULL_OFFSET_Y=8

PGCR_CLASSIC_SMALL_SCALE=0.63
PGCR_CLASSIC_SMALL_OFFSET_X=0
PGCR_CLASSIC_SMALL_OFFSET_Y=8

PGCR_SPORT_FULL_SCALE=0.63
PGCR_SPORT_FULL_OFFSET_X=0
PGCR_SPORT_FULL_OFFSET_Y=8

PGCR_SPORT_SMALL_SCALE=0.63
PGCR_SPORT_SMALL_OFFSET_X=0
PGCR_SPORT_SMALL_OFFSET_Y=8

PGCR_LOG=/tmp/pgcr-mirror.log
PGCR_LOG_MAX_BYTES=524288
