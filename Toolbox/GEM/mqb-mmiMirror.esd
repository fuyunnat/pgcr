###########################################################################################
#
# PGCR - MMI Mirror V2.2 geometry lab for Audi A4L B9 / MHI2Q P0915
#
# Base screen: Lanye-z/MHI2Q-CarPlay-RGI-MMI-Mirror V2.2
# PGCR changes: reversible Classic FULL scale presets + status/restore actions.
#
###########################################################################################

screen "MMI Mirror" Customization

keyValue
    value   String sys 0x00000000 0
    label   "Audi MHI2Q MMI Mirror V2.2 / PGCR P0915"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "JAVA80: ctx80 = {98,101,102,3}; Native displayable 3 only"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "PGCR: Classic FULL geometry presets; core binaries unchanged"
    poll    0

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/install_mmi_mirror.sh"
   label   "Install/Update MMI Mirror V2.2"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/start_mmi_mirror_toolbox.sh"
   label   "Start MMI Mirror V2.2"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/stop_mmi_mirror_toolbox.sh"
   label   "Stop MMI Mirror V2.2"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_geometry_status.sh"
   label   "PGCR - Show current geometry"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_classic_full_063.sh"
   label   "PGCR Classic FULL 63% - V2.2 baseline"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_classic_full_075.sh"
   label   "PGCR Classic FULL 75%"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_classic_full_080.sh"
   label   "PGCR Classic FULL 80% - first test"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_classic_full_085.sh"
   label   "PGCR Classic FULL 85%"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_classic_full_090.sh"
   label   "PGCR Classic FULL 90%"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_classic_full_095.sh"
   label   "PGCR Classic FULL 95%"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_classic_full_100.sh"
   label   "PGCR Classic FULL 100% - edge test"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/pgcr_restore_original.sh"
   label   "PGCR - Restore pre-PGCR geometry"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/autostart_mmi_mirror_on.sh"
   label   "AutoStart ON - start after MMI boot"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/autostart_mmi_mirror_off.sh"
   label   "AutoStart OFF - manual start only"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/collect_mmi_mirror_logs.sh"
   label   "Copy V2.2 diagnostics to SD-card"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/clear_mmi_mirror_logs.sh"
   label   "Clear temporary MMI Mirror logs"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/uninstall_mmi_mirror.sh"
   label   "Restore/Uninstall MMI Mirror V2.2"
